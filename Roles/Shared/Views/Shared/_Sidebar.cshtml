@{
    var activeRole = Context.Request.Cookies["locps_demo_role"] ?? "officer";
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
}

<aside id="sidebar" class="d-flex flex-column overflow-hidden" style="height:100vh">
    <div class="sidebar-header d-flex align-items-center justify-content-between">
        <a href="/Home/Index" class="brand-logo text-truncate">
            <i class="fa-solid fa-vault text-primary"></i>
            <span class="brand-text"><span>LOCPS</span> Portal</span>
        </a>
        <button id="sidebarCollapseBtn" class="btn btn-link text-white-50 p-1 border-0 shadow-none d-none d-lg-block" style="font-size: 1.1rem;" title="Toggle Sidebar">
            <i class="fa-solid fa-angle-left"></i>
        </button>
    </div>

    <div class="nav-menu flex-grow-1 overflow-auto">
        <div class="nav-section">
            <a href="/Dashboard" class="nav-link-item @(currentPath.StartsWith("/dashboard") ? "active" : "")" title="Dashboard">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
        </div>

        @if (activeRole == "customer")
        {
            <div class="nav-section">
                <div class="nav-heading">My Services</div>
                <a href="/Customer/Create" class="nav-link-item @(currentPath.StartsWith("/customer/create") ? "active" : "")" title="Apply for Loan">
                    <i class="fa-solid fa-file-signature"></i>
                    <span>Apply for Loan</span>
                </a>
            </div>
        }

        @if (activeRole == "officer")
        {
            <div class="nav-section">
                <div class="nav-heading">Customers & Loans</div>
                <a href="/Customer" class="nav-link-item @(currentPath.StartsWith("/customer") ? "active" : "")" title="Customer Directory">
                    <i class="fa-solid fa-users"></i>
                    <span>Customer Directory</span>
                </a>
                <a href="/Loan" class="nav-link-item @(currentPath.StartsWith("/loan") ? "active" : "")" title="Loan Applications">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    <span>Loan Applications</span>
                </a>
            </div>
        }

        @if (activeRole == "underwriter")
        {
            <div class="nav-section">
                <div class="nav-heading">Credit Decisioning</div>
                <a href="/Approval" class="nav-link-item @(currentPath.StartsWith("/approval") ? "active" : "")" title="Underwriter Review">
                    <i class="fa-solid fa-signature"></i>
                    <span>Underwriter Review</span>
                </a>
                <a href="/Disbursement" class="nav-link-item @(currentPath.Contains("/disbursement") && !currentPath.Contains("/history") ? "active" : "")" title="Initiate Disbursement">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <span>Initiate Disbursement</span>
                </a>
                <a href="/Disbursement/History" class="nav-link-item @(currentPath.Contains("/disbursement/history") ? "active" : "")" title="Disbursement History">
                    <i class="fa-solid fa-money-bill-transfer"></i>
                    <span>Disbursement History</span>
                </a>
            </div>
        }

        @if (activeRole == "admin")
        {
            <div class="nav-section">
                <div class="nav-heading">Administration</div>
                <a href="/Product" class="nav-link-item @(currentPath.StartsWith("/product") ? "active" : "")" title="Loan Products">
                    <i class="fa-solid fa-box-archive"></i>
                    <span>Loan Products</span>
                </a>
                <a href="/UserManagement" class="nav-link-item @(currentPath.StartsWith("/usermanagement") ? "active" : "")" title="User Management">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>User Management</span>
                </a>
                <a href="/Settings/ScoringRules" class="nav-link-item @(currentPath.Contains("/settings/scoringrules") ? "active" : "")" title="Scoring Engine Weights">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Scoring Engine Weights</span>
                </a>
                <a href="/Settings/AuditLogs" class="nav-link-item @(currentPath.Contains("/settings/auditlogs") ? "active" : "")" title="Audit Log Trail">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>Audit Log Trail</span>
                </a>

                <div class="nav-heading">Settlement & Reports</div>
                <a href="/Disbursement/History" class="nav-link-item @(currentPath.Contains("/disbursement/history") ? "active" : "")" title="Disbursements">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <span>Disbursements</span>
                </a>
                <a href="/Reports" class="nav-link-item @(currentPath.StartsWith("/reports") ? "active" : "")" title="Reports & Analytics">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Reports & Analytics</span>
                </a>
            </div>
        }
    </div>

    <div class="sidebar-footer">
        <div class="mt-3 text-center">
            <a href="/Account/Logout" class="text-white-50 small text-decoration-none" title="Sign Out">
                <i class="fa-solid fa-right-from-bracket me-1"></i>
                <span class="brand-text">Sign Out</span>
            </a>
        </div>
    </div>
</aside>
