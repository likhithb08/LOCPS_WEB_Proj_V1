@model LOCPS.Models.LoanApplication
@{
    ViewData["Title"] = "KYC Document Verification";
    ViewData["CurrentStep"] = "KYC Verification";
    var kyc = ViewBag.Kyc as LOCPS.Models.Kyc;
    var docs = ViewBag.Documents as IEnumerable<LOCPS.Models.Document> ?? new List<LOCPS.Models.Document>();
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="h3 fw-bold text-dark mb-1">KYC Compliance Check</h1>
        <p class="text-muted">Perform mandatory identity checks for Application <strong>@Model.ApplicationNumber</strong>.</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-controller="Loan" asp-action="Details" asp-route-id="@Model.ApplicationId" class="btn btn-light border rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Application
        </a>
    </div>
</div>

@await Html.PartialAsync("_WorkflowStepper")

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="card-title fw-bold text-dark m-0">Mandatory Verification Items</h5>
            </div>
            <div class="card-body pt-0">
                @if (kyc == null)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-solid fa-triangle-exclamation fa-3x mb-3 text-warning"></i>
                        <h6>KYC not submitted yet.</h6>
                        <p class="small">Initiate KYC to notify the customer to provide their details.</p>
                        @if (Model.Status == LOCPS.Enums.ApplicationStatus.Submitted)
                        {
                            <form asp-controller="Kyc" asp-action="Initiate" method="post" class="d-inline">
                                <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                                <button type="submit" class="btn btn-primary rounded-pill shadow-sm px-4">
                                    <i class="fa-solid fa-play me-2"></i> Initiate KYC
                                </button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    var panVerified = !string.IsNullOrEmpty(kyc.PanNumber);
                    var aadhaarVerified = !string.IsNullOrEmpty(kyc.AadhaarNumber);
                    var addressVerified = !string.IsNullOrEmpty(kyc.AddressProof);
                    var kycStatusClass = kyc.VerificationStatus == LOCPS.Enums.KycStatus.Verified ? "success" : (kyc.VerificationStatus == LOCPS.Enums.KycStatus.Rejected ? "danger" : "warning");


                    <!-- PAN Verification -->
                    <div class="py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center border border-@(panVerified ? "success" : "warning") text-@(panVerified ? "success" : "warning") bg-@(panVerified ? "success" : "warning") bg-opacity-10" style="width: 38px; height: 38px; font-weight: 700;">
                                <i class="fa-solid fa-@(panVerified ? "check" : "clock")"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">PAN Card Verification</div>
                                <span class="text-muted small">
                                    @if (panVerified)
                                    {
                                        <text>PAN: @kyc.PanNumber — Verified against Income Tax database.</text>
                                    }
                                    else
                                    {
                                        <text>Awaiting PAN details from customer.</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <span class="badge-status badge-status-@(panVerified ? "approved" : "pending")">@(panVerified ? "Verified" : "Pending")</span>
                    </div>

                    <!-- Aadhaar Verification -->
                    <div class="py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center border border-@(aadhaarVerified ? "success" : "warning") text-@(aadhaarVerified ? "success" : "warning") bg-@(aadhaarVerified ? "success" : "warning") bg-opacity-10" style="width: 38px; height: 38px; font-weight: 700;">
                                <i class="fa-solid fa-@(aadhaarVerified ? "check" : "clock")"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">Aadhaar Bio-metrics Match</div>
                                <span class="text-muted small">
                                    @if (aadhaarVerified)
                                    {
                                        <text>Aadhaar: @kyc.AadhaarNumber — OTP confirmed.</text>
                                    }
                                    else
                                    {
                                        <text>Awaiting Aadhaar details from customer.</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <span class="badge-status badge-status-@(aadhaarVerified ? "approved" : "pending")">@(aadhaarVerified ? "Verified" : "Pending")</span>
                    </div>

                    <!-- Address Verification -->
                    <div class="py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center border border-@(addressVerified ? "success" : "warning") text-@(addressVerified ? "success" : "warning") bg-@(addressVerified ? "success" : "warning") bg-opacity-10" style="width: 38px; height: 38px; font-weight: 700;">
                                <i class="fa-solid fa-@(addressVerified ? "check" : "clock")"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">Address Matching Checks</div>
                                <span class="text-muted small">
                                    @if (addressVerified)
                                    {
                                        <text>Address proof uploaded: @kyc.AddressProof</text>
                                    }
                                    else
                                    {
                                        <text>Awaiting address proof from customer.</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <span class="badge-status badge-status-@(addressVerified ? "approved" : "pending")">@(addressVerified ? "Verified" : "Pending")</span>
                    </div>

                    <!-- KYC Decision -->
                    @if (kyc.VerificationStatus == LOCPS.Enums.KycStatus.Pending)
                    {
                        <hr class="my-4" />
                        <h6 class="fw-bold mb-3">Overall KYC Decision</h6>
                        <form asp-controller="Kyc" asp-action="Verify" method="post">
                            <input type="hidden" name="kycId" value="@kyc.KycId" />
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <div class="mb-3">
                                <label class="form-label small text-muted">Remarks (Optional)</label>
                                <textarea name="remarks" class="form-control rounded-3 bg-light shadow-none" rows="2" placeholder="Add remarks..."></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" name="status" value="@LOCPS.Enums.KycStatus.Verified" class="btn btn-success px-4 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-circle-check me-2"></i>Approve KYC
                                </button>
                                <button type="submit" name="status" value="@LOCPS.Enums.KycStatus.Rejected" class="btn btn-danger px-4 rounded-pill shadow-sm">
                                    <i class="fa-solid fa-xmark me-2"></i>Reject KYC
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="mt-4 pt-3">
                            <div class="alert alert-@kycStatusClass mb-0">
                                <i class="fa-solid fa-@(kyc.VerificationStatus == LOCPS.Enums.KycStatus.Verified ? "circle-check" : "circle-xmark") me-2"></i>
                                KYC has been <strong>@kyc.VerificationStatus.ToString()</strong>.
                                @if (!string.IsNullOrEmpty(kyc.Remarks))
                                {
                                    <span class="ms-2">Remarks: @kyc.Remarks</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3"><h6 class="fw-bold text-dark m-0">Applicant Verification Info</h6></div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush" style="font-size: 0.85rem;">
                    <li class="list-group-item px-0 py-3">
                        <div class="text-muted">Applicant Name</div>
                        <div class="fw-bold mt-1 text-dark">@Model.Customer.FullName</div>
                    </li>
                    @if (kyc != null && !string.IsNullOrEmpty(kyc.PanNumber))
                    {
                        <li class="list-group-item px-0 py-3">
                            <div class="text-muted">PAN Card Number</div>
                            <div class="fw-semibold text-secondary mt-1">@kyc.PanNumber</div>
                        </li>
                    }
                    @if (kyc != null && !string.IsNullOrEmpty(kyc.AadhaarNumber))
                    {
                        <li class="list-group-item px-0 py-3">
                            <div class="text-muted">Aadhaar Number</div>
                            <div class="fw-semibold text-secondary mt-1">@kyc.AadhaarNumber</div>
                        </li>
                    }
                    @if (kyc != null && !string.IsNullOrEmpty(kyc.AddressProof))
                    {
                        <li class="list-group-item px-0 py-3">
                            <div class="text-muted">Address Proof Document</div>
                            <div class="fw-semibold text-secondary mt-1">@kyc.AddressProof</div>
                        </li>
                    }
                    <li class="list-group-item px-0 py-3">
                        <div class="text-muted">Email</div>
                        <div class="fw-semibold text-secondary mt-1">@Model.Customer.Email</div>
                    </li>
                    <li class="list-group-item px-0 py-3">
                        <div class="text-muted">Phone</div>
                        <div class="fw-semibold text-secondary mt-1">@Model.Customer.PhoneNumber</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
